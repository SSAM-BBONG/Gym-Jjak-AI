# 실행 환경: local | test | production
APP_ENV=local

# Google AI Studio API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=20

# Spring과 FastAPI가 공유하는 서버 간 인증 키
SPRING_BASE_URL=http://localhost:8080
INTERNAL_API_KEY=

# ChromaDB (local은 persistent, production은 http)
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=data/indexes/chroma

# Presigned 이미지 다운로드 제한 (식단 분석)
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=5
IMAGE_MAX_BYTES=10485760
